import "../assets/NotoSansSC-Regular.otf";

export struct ShelfRow {
    book-id: string, title: string, author: string,
    cover: image, cover-state: int, finished: bool,
}

// Shared paper and ink tones from Figma frame 3:2.
global Paper {
    out property <color> background: #f4f1e9;
    out property <color> surface: #f7f6f0;
    out property <color> ink: #2e2e2e;
    out property <color> muted: #7a7a7a;
    out property <color> line: #c7c7c7;
}

// Native Slint equivalents of the prototype's Code Connect icon components.
component InkIcon inherits Path {
    in property <string> name;
    in property <color> ink: Paper.ink;
    width: 28px; height: 28px;
    viewbox-width: 24; viewbox-height: 24;
    stroke: root.ink; stroke-width: 1.9px;
    fill: transparent;
    commands: root.name == "search" ? "M21 21 L16.6 16.6 M19 11 A8 8 0 1 1 3 11 A8 8 0 1 1 19 11"
        : root.name == "book" ? "M12 5 L12 21 M12 5 Q8 2 2 4 L2 20 Q8 18 12 21 Q16 18 22 20 L22 4 Q16 2 12 5"
        : root.name == "user" ? "M16 7 A4 4 0 1 1 8 7 A4 4 0 1 1 16 7 M4 22 L4 19 Q4 14 12 14 Q20 14 20 19 L20 22"
        : root.name == "compass" ? "M22 12 A10 10 0 1 1 2 12 A10 10 0 1 1 22 12 M16 8 L14 14 L8 16 L10 10 Z"
        : root.name == "up" ? "M6 15 L12 9 L18 15"
        : root.name == "down" ? "M6 9 L12 15 L18 9"
        : root.name == "close" ? "M6 6 L18 18 M18 6 L6 18"
        : "M20 7 A9 9 0 1 0 21 15 M20 2 L20 7 L15 7";
}

component InkButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <float> scale: 1;
    callback activated();
    accessible-role: button;
    accessible-label: root.label;
    min-height: 44px * root.scale;
    border-width: 1px;
    border-color: root.enabled ? #8c8c8c : Paper.line;
    border-radius: self.height / 2;
    background: touch.pressed && root.enabled ? #dedbd3 : root.primary ? Paper.ink : Paper.surface;
    Text {
        text: root.label;
        color: !root.enabled ? #aaa : root.primary ? Paper.background : Paper.ink;
        font-size: 18px * root.scale;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.activated(); } }
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <length> icon-size: 28px;
    in property <bool> enabled: true;
    in property <float> scale: 1;
    callback activated();
    accessible-role: button;
    accessible-label: root.label;
    background: touch.pressed && root.enabled ? #dedbd3 : transparent;
    border-radius: 20px * root.scale;
    InkIcon {
        name: root.icon;
        width: root.icon-size * root.scale; height: self.width;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        ink: root.enabled ? Paper.ink : #bcbab4;
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.activated(); } }
}

export component AppWindow inherits Window {
    title: "rereader · 微信读书";
    preferred-width: 600px; preferred-height: 800px;
    min-width: 480px; min-height: 640px;
    background: Paper.background;
    default-font-family: "Noto Sans SC";
    default-font-size: 20px;
    private property <float> scale: min(root.width / 820px, root.height / 1060px);
    in-out property <int> page: 1;
    in property <[ShelfRow]> books;
    in property <int> total-books;
    in-out property <string> query;
    in property <bool> logged-in: false;
    in property <bool> busy: false;
    in property <bool> has-qr: false;
    in property <image> qr-image;
    in property <string> account;
    in property <string> reading-time;
    in property <string> weekly-reading-time;
    in property <string> status: "点击登录，扫码查看微信读书书架";
    in-out property <bool> account-open: false;
    out property <int> page-count: max(1, ceil(root.books.length / 12));
    callback login(); callback refresh(); callback logout(); callback search();
    callback next-page(); callback previous-page(); callback exit();

    Rectangle {
        x: 0px; y: 0px; width: 100%; height: 100%;
        VerticalLayout {
            width: parent.width; height: parent.height;
            padding: 0px; spacing: 0px;
            VerticalLayout {
                padding-left: 38px * root.scale; padding-right: 38px * root.scale;
                padding-top: 5px * root.scale; padding-bottom: 0px;
                spacing: 0px;
                HorizontalLayout {
                    height: 34px * root.scale;
                    Text { text: "微信读书"; font-size: 17px * root.scale; color: #3d3d3d; vertical-alignment: center; }
                    Text {
                        text: root.logged-in ? (root.busy ? "正在同步…" : "共 " + root.total-books + " 本书") : "rereader";
                        font-size: 17px * root.scale; color: Paper.muted;
                        horizontal-alignment: right; vertical-alignment: center;
                    }
                }
                search-box := Rectangle {
                    height: 48px * root.scale;
                    border-radius: self.height / 2; border-width: 1px; border-color: #8c8c8c;
                    background: Paper.surface;
                    InkIcon { name: "search"; x: 16px * root.scale; y: (parent.height - self.height) / 2; width: 28px * root.scale; height: self.width; ink: root.logged-in ? Paper.ink : #9e9e9e; }
                    if root.query == "": Text {
                        x: 64px * root.scale; height: parent.height;
                        text: "搜索书架"; color: #9e9e9e; font-size: 19px * root.scale; vertical-alignment: center;
                    }
                    TextInput {
                        x: 64px * root.scale; y: 2px;
                        width: parent.width - 110px * root.scale; height: parent.height - 4px;
                        text <=> root.query; enabled: root.logged-in;
                        single-line: true; color: Paper.ink; font-size: 19px * root.scale;
                        vertical-alignment: center;
                        edited => { root.page = 1; root.search(); }
                    }
                    if root.query != "": IconButton {
                        icon: "close"; label: "清除搜索"; scale: root.scale;
                        x: parent.width - self.width - 4px; width: 42px * root.scale; height: parent.height;
                        activated => { root.query = ""; root.search(); }
                    }
                }
                Rectangle { height: 19px * root.scale; }
                HorizontalLayout {
                    height: 46px * root.scale; spacing: 12px * root.scale;
                    Text { text: root.account-open ? "我的" : "书架"; font-size: 29px * root.scale; font-weight: 500; color: Paper.ink; vertical-alignment: center; }
                    if root.logged-in: Rectangle {
                        width: 92px * root.scale;
                        InkIcon { name: "refresh"; x: 0px; width: 24px * root.scale; height: self.width; y: (parent.height - self.height) / 2; ink: root.busy ? #aaa : Paper.muted; }
                        Text { x: 32px * root.scale; height: parent.height; text: root.busy ? "同步中" : "刷新"; font-size: 19px * root.scale; color: Paper.muted; vertical-alignment: center; }
                        TouchArea { enabled: !root.busy; clicked => { root.refresh(); } }
                    }
                    if root.logged-in: Rectangle {
                        width: 80px * root.scale;
                        InkIcon { name: "user"; x: 0px; width: 24px * root.scale; height: self.width; y: (parent.height - self.height) / 2; ink: Paper.muted; }
                        Text { x: 30px * root.scale; height: parent.height; text: root.account-open ? "返回" : "我的"; font-size: 19px * root.scale; color: Paper.muted; vertical-alignment: center; }
                        TouchArea { clicked => { root.account-open = !root.account-open; } }
                    }
                }
                Rectangle { height: 18px * root.scale; }
                content := Rectangle {
                    vertical-stretch: 1;
                    if root.logged-in && !root.account-open: Rectangle {
                        for book[index] in root.books: Rectangle {
                            visible: index >= (root.page - 1) * 12 && index < root.page * 12;
                            private property <length> column-step: (parent.width + 16px * root.scale) / 4;
                            width: self.column-step - 18px * root.scale;
                            height: parent.height / 3;
                            x: mod(index, 4) * self.column-step;
                            y: mod(floor(index / 4), 3) * self.height;
                            cover := Rectangle {
                                x: 0px; y: 0px;
                                width: min(150px * root.scale, parent.width);
                                height: min(self.width * 213 / 150, parent.height - 50px * root.scale);
                                background: #e6e2d9;
                                clip: true;
                                if book.cover-state == 1: Image {
                                    width: parent.width; height: parent.height;
                                    source: book.cover; image-fit: contain;
                                }
                                if book.cover-state != 1: Rectangle {
                                    x: 8px * root.scale; y: 8px * root.scale;
                                    width: parent.width - 16px * root.scale; height: parent.height - 16px * root.scale;
                                    border-width: 1px; border-color: #c2beb5;
                                    VerticalLayout {
                                        padding: 12px * root.scale; spacing: 8px * root.scale;
                                        Text { text: book.title; wrap: word-wrap; overflow: elide; font-size: 18px * root.scale; color: #555; vertical-alignment: center; }
                                        Text { text: book.author; overflow: elide; font-size: 12px * root.scale; color: Paper.muted; }
                                        Text { text: book.cover-state == 0 ? "加载封面…" : "暂无封面"; font-size: 11px * root.scale; color: Paper.muted; height: 20px * root.scale; }
                                    }
                                }
                                if book.finished: Rectangle {
                                    x: parent.width - self.width - 4px * root.scale; y: 4px * root.scale;
                                    width: 46px * root.scale; height: 24px * root.scale;
                                    background: #f0ede3; border-radius: 1px;
                                    Text { text: "读完"; font-size: 12px * root.scale; color: #3b3b3b; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                            Text {
                                x: 0px; y: cover.height + 7px * root.scale; height: 30px * root.scale;
                                width: parent.width;
                                text: book.title; color: #303030; font-size: 18px * root.scale;
                                overflow: elide; vertical-alignment: center;
                            }
                        }
                        if root.books.length == 0: VerticalLayout {
                            alignment: center; spacing: 18px * root.scale;
                            HorizontalLayout {
                                Rectangle { }
                                InkIcon { name: "book"; width: 56px * root.scale; height: self.width; ink: #9e9b92; }
                                Rectangle { }
                            }
                            Text {
                                text: root.query != "" ? "没有找到匹配的书籍" : root.busy ? "正在加载书架…" : "书架还是空的";
                                color: Paper.muted; font-size: 20px * root.scale; horizontal-alignment: center;
                            }
                            Text { text: root.query != "" ? "试试其他书名或作者" : "刷新以同步微信读书书架"; color: Paper.muted; font-size: 16px * root.scale; horizontal-alignment: center; }
                        }
                    }
                    if !root.logged-in || root.account-open: VerticalLayout {
                        alignment: center; spacing: 22px * root.scale;
                        HorizontalLayout {
                            Rectangle { }
                            InkIcon { name: root.logged-in ? "user" : "book"; width: 54px * root.scale; height: self.width; }
                            Rectangle { }
                        }
                        Text { text: root.logged-in ? root.account : "你的微信读书，随手可读"; color: Paper.ink; font-size: 25px * root.scale; horizontal-alignment: center; }
                        if root.logged-in: Rectangle {
                            height: 156px * root.scale;
                            background: Paper.surface;
                            border-width: 1px; border-color: Paper.line;
                            border-radius: 12px * root.scale;
                            VerticalLayout {
                                padding: 22px * root.scale; spacing: 18px * root.scale;
                                HorizontalLayout {
                                    Text { text: "累计阅读时长"; color: Paper.muted; font-size: 20px * root.scale; vertical-alignment: center; }
                                    Text { text: root.reading-time; color: Paper.ink; font-size: 24px * root.scale; horizontal-alignment: right; vertical-alignment: center; }
                                }
                                Rectangle { height: 1px; background: Paper.line; }
                                HorizontalLayout {
                                    Text { text: "本周阅读时间"; color: Paper.muted; font-size: 20px * root.scale; vertical-alignment: center; }
                                    Text { text: root.weekly-reading-time; color: Paper.ink; font-size: 24px * root.scale; horizontal-alignment: right; vertical-alignment: center; }
                                }
                            }
                        }
                        if !root.logged-in && root.has-qr: HorizontalLayout {
                            Rectangle { }
                            Rectangle {
                                width: 296px * root.scale; height: self.width; background: #fff;
                                Image { x: 8px * root.scale; y: self.x; width: 280px * root.scale; height: self.width; source: root.qr-image; image-fit: contain; }
                            }
                            Rectangle { }
                        }
                        Text {
                            text: root.logged-in ? "书架已连接微信读书" : root.has-qr ? "使用微信扫一扫，在手机上确认登录" : "扫码登录，同步你的私人书架";
                            font-size: 18px * root.scale; color: Paper.muted; horizontal-alignment: center; wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 14px * root.scale;
                            Rectangle { }
                            InkButton {
                                label: root.logged-in ? "退出登录" : root.has-qr ? "更换二维码" : root.busy ? "请稍候…" : "微信扫码登录";
                                primary: !root.logged-in; scale: root.scale; width: 190px * root.scale;
                                enabled: root.logged-in || !root.busy || root.has-qr;
                                activated => { root.account-open = false; if root.logged-in { root.logout(); } else { root.login(); } }
                            }
                            if !root.logged-in && root.busy: InkButton { label: "取消"; scale: root.scale; width: 90px * root.scale; activated => { root.logout(); } }
                            Rectangle { }
                        }
                    }
                }
                Text {
                    height: 24px * root.scale;
                    text: root.status; font-size: 12px * root.scale; color: Paper.muted;
                    overflow: elide; vertical-alignment: center;
                }
            }
            Rectangle { height: 1px; background: Paper.line; }
            HorizontalLayout {
                height: 71px * root.scale;
                padding-left: 28px * root.scale; padding-right: 29px * root.scale;
                spacing: 54px * root.scale;
                IconButton { icon: "compass"; label: "同步书架"; icon-size: 38px; scale: root.scale; width: 64px * root.scale; enabled: root.logged-in && !root.busy; activated => { root.refresh(); } }
                IconButton { icon: "book"; label: "书架"; icon-size: 38px; scale: root.scale; width: 64px * root.scale; activated => { root.account-open = false; root.query = ""; root.search(); } }
                IconButton { icon: "user"; label: "我的账号"; icon-size: 38px; scale: root.scale; width: 64px * root.scale; activated => { root.account-open = !root.account-open; } }
                Rectangle { horizontal-stretch: 1; }
                if root.logged-in && !root.account-open: Text {
                    text: root.page + " / " + root.page-count;
                    font-size: 13px * root.scale; color: Paper.muted; vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                if root.logged-in && !root.account-open: Rectangle {
                    width: 112px * root.scale;
                    Rectangle {
                        x: 0px; y: (parent.height - self.height) / 2;
                        width: parent.width; height: 49px * root.scale;
                        border-radius: self.height / 2; border-width: 1px; border-color: #c2c2c2;
                        HorizontalLayout {
                            spacing: 0px; padding: 0px;
                            IconButton { icon: "up"; label: "上一页"; scale: root.scale; enabled: root.page > 1; activated => { root.previous-page(); } }
                            Rectangle { width: 1px; background: Paper.line; }
                            IconButton { icon: "down"; label: "下一页"; scale: root.scale; enabled: root.page < root.page-count; activated => { root.next-page(); } }
                        }
                    }
                }
                if !root.logged-in || root.account-open: Rectangle {
                    width: 112px * root.scale;
                    InkButton {
                        x: 0px; y: (parent.height - self.height) / 2;
                        label: "退出应用"; scale: root.scale; width: parent.width;
                        height: 44px * root.scale;
                        activated => { root.exit(); }
                    }
                }
            }
        }
    }
}
